# Local dev: scripts/devdb.sh start prints this URL.
# Supabase: Project → Connect → "Session pooler" URI (works over IPv4).
DATABASE_URL=postgresql://postgres@localhost:54329/lifeos
TZ_NAME=Asia/Seoul

# From @BotFather. Leave TELEGRAM_CHAT_ID empty, message the bot once, and it replies with your id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Images: Cloudflare R2 (or any S3 API). Leave S3_BUCKET empty to store files in .dev/media.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
